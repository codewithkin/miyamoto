# Copy to apps/web/.env and fill in.
#
# env-nextjs validates NEXT_PUBLIC_* at build time and bakes the value into
# the client bundle, so this must also be passed as a build arg when building
# the Docker image — see the ARG/ENV pair in apps/web/Dockerfile and the
# build.args block in docker-compose.yml. A missing value fails the build
# rather than the run.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
