{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.8",
    "@ai-sdk/google": "^4.0.27",
    "@hono/trpc-server": "^0.4.2",
    "@miyamoto/api": "workspace:*",
    "@miyamoto/auth": "workspace:*",
    "@miyamoto/db": "workspace:*",
    "@miyamoto/env": "workspace:*",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@miyamoto/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
