# Copy to apps/server/.env and fill in. Everything without a default is
# required for the server to boot; the optional ones degrade rather than fail,
# and each says how.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres. docker-compose overrides this to point at its own postgres
# service, so this value is for running the server outside Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miyamoto

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the auth handler is reachable — and where Google sends the phone after
# the account chooser. localhost works for a laptop browser only. For a phone
# this must be an HTTPS address the phone can reach, and it must be the same
# host as EXPO_PUBLIC_SERVER_URL in apps/native/.env.
BETTER_AUTH_URL=http://localhost:3000

# The web origin allowed to call this server.
CORS_ORIGIN=http://localhost:3001


# ── Sign-in ───────────────────────────────────────────────────────────────
# Google only, for now. Full setup, step by step: systems/06-auth.md.
#
# Create a *Web application* OAuth client in Google Cloud Console and register
# this redirect URI — the server prints the exact value at boot:
#     <BETTER_AUTH_URL>/api/auth/callback/google
#
# BETTER_AUTH_URL above must be HTTPS and reachable from the phone for this to
# work on a device; the server warns at boot if it is not.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple — off for now. Uncomment with the provider block in
# packages/auth/src/index.ts; see the end of systems/06-auth.md.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=com.anonymous.miyamoto


# ── The Masters ───────────────────────────────────────────────────────────
# The Masters run through OpenRouter (openrouter/deepseek/deepseek-v4-pro).
# Without this, chat returns an error rather than a Master's reply.
OPENROUTER_API_KEY=


# ── Mail ──────────────────────────────────────────────────────────────────
# Used for the account-deletion confirmation link. If these are absent or
# wrong, sendMail logs under [mail] and the request still reports success —
# so check deployment logs, not the UI, to know whether mail is working.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Miyamoto <no-reply@miyamoto.app>

# Public site origin, used to build the link inside that email. Wrong here
# means a confirmation link that points at the wrong host.
WEB_URL=http://localhost:3001
